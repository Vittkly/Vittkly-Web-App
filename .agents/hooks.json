{
  "auto-typecheck-post-edit": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm typecheck >/dev/null 2>&1 && echo '{}'"
          }
        ]
      }
    ]
  }
}
