{
  "name": "vittkly-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @vittkly/web dev",
    "dev:mobile": "pnpm --filter @vittkly/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "sync:db-types": "npx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > packages/db-types/src/database.types.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
